@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix progs: <http://kxstudio.sf.net/ns/lv2ext/programs#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

<https://github.com/mlainez/scva-headless#scva>
	a lv2:Plugin , lv2:InstrumentPlugin ;
	doap:name "SCVA" ;
	doap:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
	rdfs:comment "Roland SOUND Canvas VA's engine, loaded from your own SCCore.dll. Set SCVA_DLL_DIR or put SCCore.dll in this bundle." ;
	lv2:requiredFeature urid:map ;
	lv2:optionalFeature lv2:hardRTCapable , work:schedule , progs:Host ;
	lv2:extensionData progs:Interface , work:interface ;
	ui:ui <https://github.com/mlainez/scva-headless#ui> ;

	lv2:port [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 0 ;
		lv2:symbol "midi_in" ;
		lv2:name "MIDI In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out_l" ;
		lv2:name "Out L"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "out_r" ;
		lv2:name "Out R"
	] , [
		# Every control is the editor's (ui:ui below), so hosts are asked
		# not to draw them as knobs of their own.
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "map" ;
		lv2:name "Tone Map" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 4 ;
		lv2:portProperty lv2:integer , lv2:enumeration , pprops:notOnGUI ;
		lv2:scalePoint [ rdfs:label "Default" ; rdf:value 0 ] ;
		lv2:scalePoint [ rdfs:label "SC-55"   ; rdf:value 1 ] ;
		lv2:scalePoint [ rdfs:label "SC-88"   ; rdf:value 2 ] ;
		lv2:scalePoint [ rdfs:label "SC-88Pro"; rdf:value 3 ] ;
		lv2:scalePoint [ rdfs:label "SC-8820" ; rdf:value 4 ]
	] , [
		# The drum part's kit, as a GS program number; one the map lacks
		# plays Standard.
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "kit" ;
		lv2:name "Drum Kit" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 127 ;
		lv2:portProperty lv2:integer , pprops:notOnGUI
	] , [
		# The first part's tone, as a position in the map's tone list.
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "instrument" ;
		lv2:name "Instrument" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 4095 ;
		lv2:portProperty lv2:integer , pprops:notOnGUI
	] , [
		# The position the first part plays, picked here or from the program
		# list, for the editor to show.
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "tone" ;
		lv2:name "Tone" ;
		lv2:default 0 ;
		lv2:minimum -1 ;
		lv2:maximum 4095 ;
		lv2:portProperty lv2:integer , pprops:notOnGUI
	] .

<https://github.com/mlainez/scva-headless#ui>
	a ui:X11UI ;
	lv2:requiredFeature ui:idleInterface ;
	lv2:optionalFeature ui:parent , ui:resize ;
	lv2:extensionData ui:idleInterface ;
	# what the editor shows, whoever changed it: automation, a saved
	# project, the host's program list
	ui:portNotification [
		ui:plugin <https://github.com/mlainez/scva-headless#scva> ;
		lv2:symbol "map" ;
		ui:protocol ui:floatProtocol
	] , [
		ui:plugin <https://github.com/mlainez/scva-headless#scva> ;
		lv2:symbol "kit" ;
		ui:protocol ui:floatProtocol
	] , [
		ui:plugin <https://github.com/mlainez/scva-headless#scva> ;
		lv2:symbol "tone" ;
		ui:protocol ui:floatProtocol
	] .
