@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

<https://github.com/mlainez/scva-headless#vsc>
	a lv2:Plugin , lv2:InstrumentPlugin ;
	doap:name "SCVA: Virtual Sound Canvas 3.2" ;
	doap:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
	rdfs:comment "Roland Virtual Sound Canvas 3.2's engine, loaded from your own vsc.sys and its vscNN.dat tone sets. Set SCVA_DLL_DIR or put them in this bundle." ;
	lv2:requiredFeature urid:map ;
	ui:ui <https://github.com/mlainez/scva-headless#vsc_ui> ;

	lv2:port [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 0 ;
		lv2:symbol "midi_in" ;
		lv2:name "MIDI In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out_l" ;
		lv2:name "Out L"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "out_r" ;
		lv2:name "Out R"
	] , [
		# VSC's one tone set for every part; changing it reopens the engine
		# on that set, as VSC does.
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "map" ;
		lv2:name "Tone Set" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 3 ;
		lv2:portProperty lv2:integer , lv2:enumeration , pprops:notOnGUI ;
		lv2:scalePoint [ rdfs:label "Default (SC-88Pro)" ; rdf:value 0 ] ;
		lv2:scalePoint [ rdfs:label "SC-55"   ; rdf:value 1 ] ;
		lv2:scalePoint [ rdfs:label "SC-88"   ; rdf:value 2 ] ;
		lv2:scalePoint [ rdfs:label "SC-88Pro"; rdf:value 3 ]
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "kit" ;
		lv2:name "Drum Kit" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 127 ;
		lv2:portProperty lv2:integer , pprops:notOnGUI
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "instrument" ;
		lv2:name "Instrument" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 4095 ;
		lv2:portProperty lv2:integer , pprops:notOnGUI
	] .

<https://github.com/mlainez/scva-headless#vsc_ui>
	a ui:X11UI ;
	lv2:requiredFeature ui:idleInterface ;
	lv2:optionalFeature ui:parent , ui:resize ;
	lv2:extensionData ui:idleInterface ;
	ui:portNotification [
		ui:plugin <https://github.com/mlainez/scva-headless#vsc> ;
		lv2:symbol "map" ;
		ui:protocol ui:floatProtocol
	] , [
		ui:plugin <https://github.com/mlainez/scva-headless#vsc> ;
		lv2:symbol "kit" ;
		ui:protocol ui:floatProtocol
	] , [
		ui:plugin <https://github.com/mlainez/scva-headless#vsc> ;
		lv2:symbol "instrument" ;
		ui:protocol ui:floatProtocol
	] .
